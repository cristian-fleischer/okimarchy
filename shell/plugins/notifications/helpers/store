#!/usr/bin/python3
# store - the notification store, driven from Service.qml through `run store`.
#
#   policy           read {"historyHours": 0|1|24|168} on stdin
#   put              read one notification JSON on stdin, write it to live/
#   close KEY WHY    move live/KEY.json into history/, trimmed to size and age
#   drop KEY         forget a live notification without recording it
#   restore          print the live notifications, oldest first
#   history [N]      print the newest N history entries, newest first
#   tidy             drop history past its age, icons nothing has wanted, and
#                    the previous notification service's leftovers
#   quiet            print the quiet state: snoozed sources, and silencing
#   quiet-save       read the quiet state as JSON on stdin
#   held [N]         print the newest N that were never shown, newest first
#   forget-all       empty the history
#
# Everything lives in ~/.local/state/omarchy/notifications/. It is state, not cache:
# what you were told should survive a `rm -rf ~/.cache`. History is a log to
# read back, not a queue to work through. Keeping it as one file per
# notification means a half-written entry costs one notification instead of the
# lot, and the daemon can be killed at any point without needing a save step.
#
# The previous notification service used the same directory with a different
# layout: popups as <ms>-<id>.json in the root, history/<ms>-<id>.json rows
# without a `key`, and copied sender images under images/. A migration clears
# them, but the old shell keeps running until the update restarts it and can
# write one more row. Rows without this store's shape are dropped on sight and
# never surfaced; root-level files are never read; tidy removes the rest.
import json
import os
import re
import html
import shutil
import stat
from notification_files import private_dir, write_json, read_json, input_json
import sys
import time

ROOT = os.path.expanduser("~/.local/state/omarchy/notifications")
LIVE = os.path.join(ROOT, "live")
HISTORY = os.path.join(ROOT, "history")
ICONS = os.path.join(ROOT, "icons")
QUIET = os.path.join(ROOT, "quiet.json")
LEGACY_IMAGES = os.path.join(ROOT, "images")
LEGACY_POPUP = re.compile(r"[0-9]+-.+\.json")
# What history is for: replaying the last few onto the screen, and showing what
# a snooze or a silence held back. Both want the recent past, neither wants a
# fortnight of it - and every entry is the text of a message somebody sent you,
# so keeping it past its usefulness is a cost with nothing on the other side.
# Whichever of the two limits bites first wins.
HISTORY_MAX = 100
HISTORY_HOURS = 24

# Resolved icons are keyed by source and cost a lookup - sometimes a web
# request - to rebuild, so they outlive the notifications that prompted them,
# but not forever. Anything nothing has wanted for this long is a source you no
# longer have, and it resolves again by itself if you turn out to still have it.
ICON_DAYS = 60


def ensure():
  for d in (ROOT, LIVE, HISTORY, ICONS):
    private_dir(d)
  for d in (LIVE, HISTORY):
    for name in os.listdir(d):
      path = os.path.join(d, name)
      if os.path.islink(path): continue
      if name.endswith(".part"):
        os.unlink(path)
        continue
      if not name.endswith(".json"): continue
      entry = read_json(path)
      if belongs(d, name, entry):
        clean = sanitise(entry)
        if clean != entry or (os.stat(path, follow_symlinks=False).st_mode & 0o777) != 0o600:
          write_json(path, clean)
      else:
        # Oversized, corrupt or foreign rows (the previous service's
        # keyless history) must not linger with unredacted data.
        os.unlink(path)


KEY = re.compile(r"[A-Za-z0-9_-]{1,120}")


def safe(name):
  value = str(name or "")
  if not KEY.fullmatch(value):
    raise ValueError("invalid key")
  return value


def belongs(directory, name, entry):
  """Is this file a row this store wrote, under the name it would use?

  Every row carries a string `key`, and the file is named after it: KEY.json
  in live/, <13-digit ms>-KEY.json in history/. The previous service's rows
  have no key and are dropped rather than shown as blank notifications."""
  if not isinstance(entry, dict):
    return False
  key = entry.get("key")
  if not isinstance(key, str) or not KEY.fullmatch(key):
    return False
  if directory == LIVE:
    return name == key + ".json"
  return re.fullmatch(r"[0-9]{13}-" + re.escape(key) + r"\.json", name) is not None


# Keep the raw-helper/legacy check independent of caller-supplied code flags,
# but use Detect.js's vocabulary, windows and shapes. Product names and years
# are ordinary notification text; migrating them must not destroy history.
CODE_KEYWORD = re.compile(
    r"\b(code|otp|one[\s-]?time|verification|verify|passcode|pin|2fa|"
    r"two[\s-]factor|security key|confirm(?:ation)?)\b", re.IGNORECASE | re.ASCII)
CODE_SHAPE = re.compile(
    r"(?:^|[^A-Za-z0-9_-])((?:[A-Za-z]-)?[0-9]{2,4}[\s-][0-9]{2,5}|"
    r"(?:[A-Za-z]-)?[0-9]{4,8})(?![A-Za-z0-9_-])")
CODE_ALNUM = re.compile(r"(?:^|[^A-Za-z0-9_-])([A-Z0-9]{5,8})(?![A-Za-z0-9_-])")
CODE_BEFORE = 24
CODE_AFTER = 72
MAX_CODES = 8
MAX_BODY = 32768
MAX_SUMMARY = 2048


def looks_like_a_code(text):
  text = text[:MAX_BODY]
  windows = 0
  for keyword in CODE_KEYWORD.finditer(text):
    word = keyword.group()
    if word.lower() == "code" and word[0].isupper():
      before = re.search(r"([A-Za-z][A-Za-z0-9_.]*)\s+$",
                         text[max(0, keyword.start() - 20):keyword.start()])
      if (before and re.fullmatch(r"[A-Z][a-z]+|[A-Z]{2,}", before[1])
              and not CODE_KEYWORD.search(before[1])):
        continue
    chunk = text[max(0, keyword.start() - CODE_BEFORE):keyword.end() + CODE_AFTER]
    for shape in CODE_SHAPE.finditer(chunk):
      value = re.sub(r"^[A-Za-z]-", "", shape[1])
      value = re.sub(r"[\s-]", "", value)
      if 4 <= len(value) <= 8 and not re.fullmatch(r"(?:19|20)[0-9]{2}", value):
        return True
    for shape in CODE_ALNUM.finditer(chunk):
      if re.search(r"[0-9]", shape[1]) and re.search(r"[A-Z]", shape[1]):
        return True
    windows += 1
    if windows == MAX_CODES:
      break
  return False


def sanitise(entry):
  # Independently defend raw helper callers and legacy state migrations.
  allowed = {"key", "originalId", "senderPid", "app", "appIcon", "summary",
             "body", "rawBody", "bodyLine", "source", "groupKey", "urgency",
             "expireTimeout", "duration", "ts", "closed_ts", "closed_reason",
             "glyph", "execArgv"}
  # Scan the same bounded summary/rawBody/body fields as Store's redaction,
  # not metadata: keys/groupKey and app names can contain unrelated numbers
  # or product keywords. This independent detector strips raw tags before
  # decoding; unlike a display preview, it need not preserve literal markup.
  text = " ".join(entry.get(k, "")[:limit] if isinstance(entry.get(k), str) else ""
                  for k, limit in (("summary", MAX_SUMMARY), ("rawBody", MAX_BODY),
                                   ("body", MAX_BODY)))[:MAX_BODY]
  text = re.sub(r"<[^>]+>", " ", text)
  for _ in range(3):
    text = html.unescape(text)
  text = re.sub(r"\s+", " ", text).strip()
  secret = bool(entry.get("code") or entry.get("codes")) or looks_like_a_code(text)
  out = {k: v for k, v in entry.items() if k in allowed and isinstance(v, (str, int, float, bool))}
  if "glyph" in out and not valid_glyph(out["glyph"]):
    del out["glyph"]
  if "execArgv" in out and not valid_exec_argv(out["execArgv"]):
    out["execArgv"] = ""
  if secret:
    out = {k: v for k, v in out.items() if not isinstance(v, str) or k == "key"}
    out.update(summary="Verification notification", body="[redacted]", rawBody="[redacted]", bodyLine="[redacted]")
  # Rich text, actions, image paths and reply handles are reconstructed or dropped.
  return out


GLYPH_CHARS = 16
EXEC_ARGS = 32
EXEC_ARG_CHARS = 4096
EXEC_TOTAL_CHARS = 32768


def valid_glyph(value):
  """The omarchy-glyph hint: a short Nerd Font glyph, never a control code."""
  return (isinstance(value, str) and 0 < len(value) <= GLYPH_CHARS
          and not any(ord(c) < 32 or 127 <= ord(c) < 160 for c in value))


def valid_exec_argv(value):
  """The omarchy-exec-argv hint: a JSON argv a restored toast clicks through.

  Persisted so a toast restored after a shell restart acts like the live
  one, which makes it a stored command line: it has to be the shape the
  shell would run, not whatever a row on disk happens to hold."""
  if not isinstance(value, str) or len(value) > EXEC_TOTAL_CHARS * 2:
    return False
  try:
    argv = json.loads(value)
  except (ValueError, RecursionError):
    return False
  return (isinstance(argv, list) and 1 <= len(argv) <= EXEC_ARGS
          and all(isinstance(arg, str) and len(arg) <= EXEC_ARG_CHARS
                  and "\x00" not in arg for arg in argv)
          and argv[0] != "" and not argv[0].startswith("-")
          and sum(len(arg) for arg in argv) <= EXEC_TOTAL_CHARS)


def retention():
  settings = read_json(os.path.join(ROOT, "policy.json"))
  if not isinstance(settings, dict):
    settings = {}
  hours = settings.get("historyHours", 24)
  return hours if hours in (0, 1, 24, 168) else 24


def cmd_put():
  entry = sanitise(input_json(sys.stdin))
  key = safe(entry.get("key"))
  if not key:
    return 1
  write_json(os.path.join(LIVE, key + ".json"), entry)
  # Floods and interrupted close queues cannot grow the live directory forever.
  names = sorted(n for n in os.listdir(LIVE) if n.endswith(".json"))
  for name in names[:-100]:
    os.unlink(os.path.join(LIVE, name))
  return 0


def cmd_close(key, why):
  key = safe(key)
  src = os.path.join(LIVE, key + ".json")
  entry = read_json(src)
  if not belongs(LIVE, key + ".json", entry):
    return 0
  entry["closed_ts"] = time.time()
  entry["closed_reason"] = why
  # Named for when it closed, so the directory sorts into reading order.
  stamp = "%013d" % int(entry["closed_ts"] * 1000)
  if retention():
    write_json(os.path.join(HISTORY, "%s-%s.json" % (stamp, key)), sanitise(entry))
  try:
    os.remove(src)
  except OSError:
    pass
  trim_history()
  return 0


def cmd_drop(key):
  try:
    os.remove(os.path.join(LIVE, safe(key) + ".json"))
  except OSError:
    pass
  return 0


def trim_history():
  """Names start with the closing timestamp, so sorting is chronological and
  the age test never has to open a file."""
  files = sorted(f for f in os.listdir(HISTORY) if f.endswith(".json"))
  cutoff = (time.time() - retention() * 3600) * 1000
  doomed = set(files[:-HISTORY_MAX]) if len(files) > HISTORY_MAX else set()
  for name in files:
    try:
      if int(name.split("-", 1)[0]) < cutoff:
        doomed.add(name)
    except ValueError:
      pass
  for name in doomed:
    try:
      os.remove(os.path.join(HISTORY, name))
    except OSError:
      pass
  return len(doomed)


def trim_icons():
  """Resolved icons live under icons/, written by the icon helper."""
  cutoff = time.time() - ICON_DAYS * 86400
  dropped = 0
  for name in os.listdir(ICONS):
    path = os.path.join(ICONS, name)
    try:
      if os.path.getmtime(path) < cutoff:
        os.remove(path)
        dropped += 1
    except OSError:
      pass
  return dropped


def trim_legacy():
  """The previous notification service's popups and copied images.

  Unlinked, never followed: a symlink planted where images/ was goes, and
  whatever it pointed at stays."""
  dropped = 0
  for name in os.listdir(ROOT):
    path = os.path.join(ROOT, name)
    try:
      info = os.lstat(path)
      if name == "images" and stat.S_ISDIR(info.st_mode):
        shutil.rmtree(path)
      elif name == "images" or (LEGACY_POPUP.fullmatch(name)
                                and not stat.S_ISDIR(info.st_mode)):
        os.unlink(path)
      else:
        continue
      dropped += 1
    except OSError:
      pass
  return dropped


def cmd_tidy():
  trim_legacy()
  sys.stdout.write("%d history, %d icons" % (trim_history(), trim_icons()))
  return 0


def listing(directory, limit=None, newest_first=False):
  files = sorted(f for f in os.listdir(directory) if f.endswith(".json"))
  if newest_first:
    files.reverse()
  files = files[:max(0, min(100, limit if limit is not None else 100))]
  out = []
  for name in files:
    entry = read_json(os.path.join(directory, name))
    # ensure() already dropped foreign rows; this catches one written
    # since, by a previous-generation shell still running.
    if belongs(directory, name, entry):
      out.append(entry)
  return out


# What was kept from you, as opposed to what you saw and dealt with. The
# distinction is the closing reason, recorded for every entry: only these two
# mean "this never reached the screen".
HELD_REASONS = ("snoozed", "silenced")


def cmd_held(limit):
  out = []
  for name in sorted(os.listdir(HISTORY), reverse=True):
    if not name.endswith(".json"):
      continue
    entry = read_json(os.path.join(HISTORY, name))
    if belongs(HISTORY, name, entry) and entry.get("closed_reason") in HELD_REASONS:
      out.append(entry)
      if len(out) >= limit:
        break
  json.dump(out, sys.stdout, separators=(",", ":"))
  return 0


def cmd_forget_all():
  for name in os.listdir(HISTORY):
    try:
      os.remove(os.path.join(HISTORY, name))
    except OSError:
      pass
  return 0


def cmd_quiet_save():
  """Every decision to not be interrupted, in one file: which sources are
  snoozed and until when, and whether the desktop is silenced. A handful of
  entries that change only when someone asks for quiet, so there is nothing
  to gain from tracking them separately."""
  value = input_json(sys.stdin)
  if not isinstance(value, dict):
    return 1
  write_json(QUIET, value)
  return 0


def read_quiet():
  state = read_json(QUIET)
  return state if isinstance(state, dict) else {"snoozes": {}}


def main():
  ensure()
  trim_history()
  args = sys.argv[1:]
  if not args:
    return 2
  verb = args[0]
  if verb == "policy":
    value = input_json(sys.stdin)
    hours = value.get("historyHours", 24)
    if hours not in (0, 1, 24, 168):
      return 2
    write_json(os.path.join(ROOT, "policy.json"), {"historyHours": hours})
    trim_history()
    return 0
  if verb == "put":
    return cmd_put()
  if verb == "close":
    return cmd_close(args[1], args[2] if len(args) > 2 else "")
  if verb == "drop":
    return cmd_drop(args[1])
  if verb == "restore":
    json.dump(listing(LIVE), sys.stdout, separators=(",", ":"))
    return 0
  if verb == "history":
    limit = int(args[1]) if len(args) > 1 else 60
    json.dump(listing(HISTORY, limit, newest_first=True), sys.stdout,
              separators=(",", ":"))
    return 0
  if verb == "held":
    return cmd_held(int(args[1]) if len(args) > 1 else 60)
  if verb == "forget-all":
    return cmd_forget_all()
  if verb == "quiet":
    json.dump(read_quiet(), sys.stdout, separators=(",", ":"))
    return 0
  if verb == "quiet-save":
    return cmd_quiet_save()
  if verb == "tidy":
    return cmd_tidy()
  return 2


if __name__ == "__main__":
  try:
    sys.exit(main())
  except BrokenPipeError:
    pass
  except (OSError, ValueError, TypeError, IndexError, RecursionError):
    sys.stderr.write("omarchy notification store: invalid input or unavailable private state\n")
    sys.exit(1)
