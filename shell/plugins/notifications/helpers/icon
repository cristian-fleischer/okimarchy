#!/usr/bin/python3
# icon - work out what picture belongs to a notification.
#
#   run icon --key web:app.slack.com --app "Google Chrome" \
#                 --app-icon google-chrome --source app.slack.com \
#            --scheme dark [--fetch]
#   run icon --sender-image      (an image path on stdin; prints a data: URL)
#
# Prints a path, or nothing. The order is deliberate: anything you have put
# there yourself wins, then anything already installed on the machine, and only
# then the site itself - which is the one step that touches the network, and so
# the one step that has to be asked for.
import argparse
import base64
import glob
import hashlib
import io
import json
import math
import os
import re
import stat
import sys
import time
import urllib.parse
import warnings
from notification_http import fetch as get, parse_url, public_hostname
from notification_files import private_dir, write_bytes, write_json, read_json

CONFIG = os.path.expanduser("~/.config/omarchy/notifications/icons")
CACHE = os.path.expanduser("~/.local/state/omarchy/notifications/icons")
INDEX = os.path.join(CACHE, "index.json")
RETRY_AFTER = 7 * 86400          # do not hammer a site that has no icon

ICON_DIRS = [
    os.path.expanduser("~/.local/share/icons"),
    "/usr/share/icons",
    "/usr/share/pixmaps",
]
APP_DIRS = [
    os.path.expanduser("~/.local/share/applications"),
    "/usr/share/applications",
]
EXTS = (".png", ".svg", ".jpg", ".jpeg", ".webp", ".ico")


NORM = 128          # every icon ends up this size, however it arrived
PAGE_BYTES = 512 * 1024
MANIFEST_BYTES = 256 * 1024
REMOTE_ICON_BYTES = 1024 * 1024
CACHED_ICON_BYTES = 256 * 1024
MAX_ICON_LINKS = 16
MAX_MANIFESTS = 2
MAX_MANIFEST_ICONS = 16
MAX_ICON_REQUESTS = 6
MAX_REMOTE_SIDE = 2048
MAX_REMOTE_PIXELS = MAX_REMOTE_SIDE * MAX_REMOTE_SIDE
REMOTE_FORMATS = ("PNG", "JPEG", "WEBP", "ICO")
SENDER_IMAGE_DATA_URL_CHARS = 131072


def is_mono_glyph(im, opaque):
  """Is this a one-colour mark on nothing?

  KDE Connect's Messages icon is a black speech bubble on transparency. On a
  dark card it is a black shape on a black background - technically present,
  practically invisible, and the same in reverse for a white glyph on a light
  theme. A mark like that carries no colour information worth keeping, so it
  can be redrawn in the theme's text colour and always read. A mark that has
  its own backdrop, or any real colour in it, is left alone."""
  if opaque:
    return False                       # it brought its own background
  small = im.resize((32, 32))   # default resampling: PIL is imported inside normalise
  spread = 0
  lums = []
  # getdata() is deprecated from Pillow 12.1 and goes in Pillow 14.
  pixels = (small.get_flattened_data() if hasattr(small, "get_flattened_data")
            else small.getdata())
  for r, g, b, a in pixels:
    if a < 40:
      continue
    spread += max(r, g, b) - min(r, g, b)
    lums.append((r * 299 + g * 587 + b * 114) // 1000)
  n = len(lums)
  if n < 24:                             # too little ink to judge
    return False
  spread /= float(n)
  mean = sum(lums) / float(n)
  variance = sum((l - mean) ** 2 for l in lums) / float(n)
  coverage = n / float(32 * 32)
  # One colour means one colour: low saturation is not enough on its own.
  # X's mark is a white glyph on a black square - no hue anywhere, an average
  # luminance down in the dark end, and repainting it in the theme colour
  # turned the whole logo into a filled square. What separates that from a
  # genuine one-tone glyph is spread of *brightness*, and how much of the
  # canvas is covered: a mark with its own filled backdrop covers nearly all
  # of it, a bare glyph does not.
  return (spread < 26
          and variance < 1600                # ~40 luminance levels of spread
          and coverage < 0.82
          and (mean < 90 or mean > 170))


def normalise(path):
  """Render an icon to one consistent shape.

  Icons arrive in three habits: a full-bleed opaque square (Linear), a
  transparent glyph with no padding (Slack), a circle (Spotify). Drawn at the
  same box they read as three different sizes, because what varies is not the
  file's dimensions but how much of them the mark actually fills. This trims
  each one to its own content, fits it into a common canvas with a margin,
  and rounds the corners of the ones that carry their own background."""
  try:
    from PIL import Image, ImageDraw
  except ImportError:
    return path
  if path.lower().endswith(".svg"):
    return path                        # left to Qt, which renders SVG well
  try:
    Image.MAX_IMAGE_PIXELS = 2048 * 2048
    im = Image.open(path)
    if max(im.size) > 2048: return None
    im = im.convert("RGBA")
  except Exception:
    # If PIL cannot read it, Qt very likely cannot either - a favicon
    # served as HTML, an .ico in a variant nobody supports. Handing the
    # path over anyway produced a card with a broken-image box and a stream
    # of decoding errors in the log. Better to have no icon.
    return None
  if im.width < 8 or im.height < 8:
    return None

  box = im.getbbox()                     # drop transparent padding
  if box:
    im = im.crop(box)

  alpha = im.getchannel("A")
  opaque = alpha.getextrema()[0] > 250   # no transparency: it has a backdrop
  mono = is_mono_glyph(im, opaque)

  # A mark with its own background keeps more of the canvas and gets rounded
  # corners; a bare glyph is inset a little further so it does not out-weigh
  # the boxed ones sitting above and below it.
  fill = 0.94 if opaque else 0.82
  side = int(NORM * fill)
  # Resize, not thumbnail: thumbnail only ever shrinks, so a 32px favicon
  # stayed 32px on a 128px canvas and came out a quarter the size of the
  # icon next to it. That was the whole "different sizes" problem.
  scale = side / float(max(im.width, im.height))
  im = im.resize((max(1, int(im.width * scale)), max(1, int(im.height * scale))),
                 Image.LANCZOS)

  if opaque:
    mask = Image.new("L", im.size, 0)
    ImageDraw.Draw(mask).rounded_rectangle([0, 0, im.width - 1, im.height - 1],
                                           radius=int(min(im.size) * 0.22), fill=255)
    im.putalpha(mask)

  canvas = Image.new("RGBA", (NORM, NORM), (0, 0, 0, 0))
  canvas.paste(im, ((NORM - im.width) // 2, (NORM - im.height) // 2), im)

  # The name carries the finding: a monochrome glyph is drawn in the theme's
  # own text colour instead of as-is, and the drawing happens in QML, which
  # cannot look at pixels. A suffix is the whole protocol.
  dest = os.path.join(CACHE, "norm-" + slug(os.path.basename(path))
                      + ("-mono" if mono else "") + ".png")
  try:
    os.makedirs(CACHE, exist_ok=True)
    buf = io.BytesIO()
    canvas.save(buf, format="PNG")
    write_bytes(dest, buf.getvalue())
  except Exception:
    return None
  return dest


def slug(text):
  return re.sub(r"[^a-z0-9._-]+", "-", str(text or "")[:256].lower()).strip("-.")[:100]


# ---------------------------------------------------------------- 1. yours
def from_config(names):
  """~/.config/omarchy/notifications/icons/<name>.png - drop a file in, done."""
  for name in names:
    for ext in EXTS:
      path = os.path.join(CONFIG, slug(name) + ext)
      if os.path.isfile(path) and os.path.realpath(path).startswith(os.path.realpath(CONFIG) + os.sep):
        return path
  return None


# ---------------------------------------------------------------- 2. installed
def from_icon_theme(names):
  """Whatever the machine already has for this name."""
  for name in names:
    # The name as given, then the slugged form. Icon files are not all
    # lowercase - "LimineSnapperSync.png" is on this machine - and a glob
    # on a case-sensitive filesystem does not care what the spec says
    # names ought to look like.
    for n in [str(name or "").strip(), slug(name)]:
      if not re.fullmatch(r"[A-Za-z0-9_-][A-Za-z0-9_.-]{0,255}", n):
        continue
      for base in ICON_DIRS:
        # Biggest first: these get drawn at 38px, and downscaling
        # beats up.
        for pattern in ("%s/hicolor/512x512/apps/%s.*", "%s/hicolor/256x256/apps/%s.*",
                        "%s/hicolor/128x128/apps/%s.*", "%s/hicolor/scalable/apps/%s.*",
                        "%s/hicolor/64x64/apps/%s.*", "%s/*/*/apps/%s.*", "%s/%s.*"):
          for hit in sorted(glob.glob(pattern % (base, n))):
            if hit.lower().endswith(EXTS) and os.path.realpath(hit).startswith(os.path.realpath(base) + os.sep):
              return hit
  return None


def from_desktop_entries(names):
  """A .desktop file that answers to this name, and the icon it declares.

  This is what catches "app.slack.com" -> the installed Slack: the entry's
  name, its window class or its exec line all mention slack."""
  wanted = [slug(n) for n in names if slug(n)]
  if not wanted:
    return None
  for base in APP_DIRS:
    for path in glob.glob(base + "/*.desktop"):
      try:
        with open(path, errors="replace") as f:
          text = f.read(65536)
      except OSError:
        continue
      fields = {}
      for key in ("Name", "Icon", "StartupWMClass", "Exec"):
        m = re.search(r"^%s=(.+)$" % key, text, re.M)
        if m:
          fields[key] = m.group(1).strip()
      if "Icon" not in fields:
        continue
      haystack = " ".join([slug(os.path.basename(path)[:-8]),
                           slug(fields.get("Name")),
                           slug(fields.get("StartupWMClass")),
                           slug(fields.get("Exec"))])
      for want in wanted:
        if len(want) < 3:
          continue
        if want in haystack.split("-") or ("-" + want + "-") in ("-" + haystack + "-"):
          found = from_icon_theme([fields["Icon"]])
          if found:
            return found
          if (os.path.isabs(fields["Icon"]) and os.path.isfile(fields["Icon"])
                  and any(os.path.realpath(fields["Icon"]).startswith(os.path.realpath(d) + os.sep) for d in ICON_DIRS)):
            return fields["Icon"]
  return None


# ---------------------------------------------------------------- 3. the site
# Names that are a description rather than a brand. Guessing a domain from one
# of these lands on whoever happened to register the generic word: "Messages"
# found messages.dev and came back wearing a stranger's logo, which is worse
# than the letter M. A phone's built-in apps are all called things like this.
def load_index():
  value = read_json(INDEX)
  return value if isinstance(value, dict) else {}


def save_index(data):
  write_json(INDEX, data)


def https_candidate(raw, base):
  """Resolve one metadata URL and accept only the hardened HTTPS grammar."""
  if not isinstance(raw, str):
    return None
  try:
    url = urllib.parse.urljoin(base, raw)
    parse_url(url)
  except (TypeError, ValueError):
    return None
  return url


def icon_links(html, base, scheme):
  """Every valid HTTPS icon the page offers, best first."""
  if not isinstance(html, str):
    return []
  out, themed = [], []
  for m in re.finditer(r"<link\s+([^>]+)>", html, re.I):
    try:
      attrs = {key.lower(): value for key, value in
               re.findall(r'(\w[\w-]*)\s*=\s*["\']([^"\']*)["\']', m.group(1))}
      rel = (attrs.get("rel") or "").lower()
      url = https_candidate(attrs.get("href"), base)
      if not url:
        continue
      media = (attrs.get("media") or "").lower()
      if "apple-touch-icon" in rel:
        (themed if scheme in media else out).append((0, url))
      elif "icon" in rel and "mask" not in rel:
        size = attrs.get("sizes", "")
        rank = 1
        try:
          rank = -int(size.split("x", 1)[0])
        except (TypeError, ValueError):
          pass
        (themed if scheme in media else out).append((rank, url))
      elif rel == "manifest":
        out.append((50, ("manifest", url)))
    except (TypeError, ValueError):
      continue
    if len(themed) + len(out) >= MAX_ICON_LINKS:
      break
  ordered = ([url for _, url in sorted(themed, key=lambda item: item[0])]
             + [url for _, url in sorted(out, key=lambda item: item[0])])
  return ordered[:MAX_ICON_LINKS]


def from_manifest(url, base):
  try:
    raw, final = get(url, MANIFEST_BYTES)
    data = json.loads(raw.decode("utf-8", "replace"))
  except Exception:
    return []
  if not isinstance(data, dict):
    return []
  icons = data.get("icons")
  if not isinstance(icons, list):
    return []
  icons = [item for item in icons[:MAX_MANIFEST_ICONS]
           if isinstance(item, dict)]

  def area(item):
    try:
      return -int(str(item.get("sizes", "0x0")).split("x", 1)[0])
    except (TypeError, ValueError):
      return 0

  result = []
  for item in sorted(icons, key=area):
    candidate = https_candidate(item.get("src"), final or base)
    if candidate:
      result.append(candidate)
  return result


def checked_raster(data, formats, max_side):
  """Fully verify and decode bounded image bytes, returning an RGBA copy."""
  if not isinstance(data, bytes):
    raise ValueError("image bytes required")
  from PIL import Image
  Image.MAX_IMAGE_PIXELS = MAX_REMOTE_PIXELS

  def metadata(image):
    if (image.format not in formats or not image.width or not image.height
            or max(image.size) > max_side
            or image.width * image.height > MAX_REMOTE_PIXELS
            or getattr(image, "n_frames", 1) != 1):
      raise ValueError("unsupported image")

  with warnings.catch_warnings():
    warnings.simplefilter("error", Image.DecompressionBombWarning)
    with Image.open(io.BytesIO(data)) as probe:
      metadata(probe)
      probe.verify()
    with Image.open(io.BytesIO(data)) as image:
      metadata(image)
      image.load()
      return image.convert("RGBA")


def normalised_remote_png(data):
  if not isinstance(data, bytes) or len(data) > REMOTE_ICON_BYTES:
    raise ValueError("oversized image")
  image = checked_raster(data, REMOTE_FORMATS, MAX_REMOTE_SIDE)
  try:
    if image.width < 8 or image.height < 8:
      raise ValueError("image too small")
    image.thumbnail((NORM, NORM))
    output = io.BytesIO()
    image.save(output, format="PNG")
    return output.getvalue()
  finally:
    image.close()


def sender_image_data_url(stream):
  """Decode one bounded image stream without persisting or naming its source."""
  data = stream.read(REMOTE_ICON_BYTES + 1)
  if len(data) > REMOTE_ICON_BYTES:
    raise ValueError("oversized image")
  png = normalised_remote_png(data)
  encoded = base64.b64encode(png).decode("ascii")
  result = "data:image/png;base64," + encoded
  if len(result) > SENDER_IMAGE_DATA_URL_CHARS:
    raise ValueError("encoded image too large")
  return result


def fetch_site(host, scheme):
  """Fetch one site's own HTTPS metadata and icon when the caller allows it."""
  host = public_hostname(host)
  if not host or scheme not in ("dark", "light"):
    return None
  base = "https://" + host + "/"
  candidates = []
  manifests = 0
  try:
    raw, final = get(base, PAGE_BYTES)
    html = raw.decode("utf-8", "replace")
    for entry in icon_links(html, final, scheme):
      if isinstance(entry, tuple) and entry[0] == "manifest":
        if manifests < MAX_MANIFESTS:
          manifests += 1
          candidates.extend(from_manifest(entry[1], final))
      else:
        candidates.append(entry)
  except Exception:
    pass
  fallback = https_candidate("/favicon.ico", base)
  if fallback:
    candidates.append(fallback)

  seen = set()
  for url in candidates:
    if url in seen:
      continue
    seen.add(url)
    if len(seen) > MAX_ICON_REQUESTS:
      break
    try:
      data, _ = get(url, REMOTE_ICON_BYTES)
      png = normalised_remote_png(data)
      dest = os.path.join(
          CACHE, "web-" + hashlib.sha256((host + scheme).encode()).hexdigest() + ".png")
      # Decoding and all resource checks above are helper-local. They do
      # not rely on Bubblewrap because the wrapper may deliberately use
      # its controlled direct mode when sandboxing is unavailable.
      write_bytes(dest, png)
    except Exception:
      continue
    return dest
  return None


def remote_cache_path(host, scheme):
  """Where a validated fetch_site(host, scheme) result would live."""
  return os.path.join(CACHE, "web-" + hashlib.sha256((host + scheme).encode()).hexdigest() + ".png")


def safe_cached_remote_icon(host, scheme, cached):
  """Return a fully decoded normalized cache entry for this host and theme."""
  if not isinstance(cached, str):
    return None
  expected = os.path.abspath(remote_cache_path(host, scheme))
  if os.path.abspath(cached) != expected:
    return None
  flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
  try:
    fd = os.open(expected, flags)
    try:
      info = os.fstat(fd)
      if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
              or info.st_nlink != 1 or not 0 < info.st_size <= CACHED_ICON_BYTES):
        return None
      os.set_blocking(fd, True)
      data = bytearray()
      while len(data) <= CACHED_ICON_BYTES:
        block = os.read(fd, min(16384, CACHED_ICON_BYTES + 1 - len(data)))
        if not block:
          break
        data.extend(block)
    finally:
      os.close(fd)
    if len(data) > CACHED_ICON_BYTES:
      return None
    image = checked_raster(bytes(data), ("PNG",), NORM)
    image.close()
  except Exception:
    return None
  return expected


def invalidate_cached_remote_icon(host, scheme, cached):
  """Unlink a rejected web-cache entry without following it anywhere."""
  if not isinstance(cached, str):
    return
  candidate = os.path.abspath(cached)
  root = os.path.abspath(CACHE)
  name = os.path.basename(candidate)
  expected = os.path.basename(remote_cache_path(host, scheme))
  legacy = ("web-" + slug(host) + "-" + scheme + ".",
            "web-" + slug(host).replace(".", "-") + "-" + scheme + ".")
  if (os.path.dirname(candidate) != root
          or (name != expected and not name.startswith(legacy))):
    return
  try:
    # unlink removes a planted symlink itself; it never touches its target.
    os.unlink(candidate)
  except OSError:
    pass


# ---------------------------------------------------------------- resolve
def host_names(source):
  """app.slack.com -> slack, app.slack.com. The middle label is almost always
  the name of the thing."""
  s = public_hostname(source)
  if not s:
    return []
  labels = [l for l in s.split(".") if l not in ("www", "app", "web", "my", "m")]
  names = [s]
  if len(labels) >= 2:
    names.append(labels[-2])
  if labels:
    names.append(labels[0])
  return names


def resolve(args):
  web = host_names(args.source)
  app = [n for n in [args.app_icon, args.source, args.app] if n]

  # Anything you dropped in the config directory wins outright.
  hit = from_config(web + app + ([args.key] if args.key else []))
  if hit:
    return hit, "from_config"

  # For a web notification, the site comes first and the browser last: the
  # other way round hands Slack, Gmail and Calendar three identical Chromes.
  # Only an exact icon-theme name is trusted here - matching .desktop entries
  # on a domain label is how "mail.google.com" ends up wearing the icon for
  # Google Contacts.
  if web:
    hit = from_icon_theme(web)
    if hit:
      return hit, "from_icon_theme:web"

  # The name the sender itself passed, if this machine has it. This has to
  # come before any guessing at websites: a sender that says `-i kitty` or
  # `-i LimineSnapperSync` has told us exactly what it wants, and the machine
  # either has that icon or it does not - there is nothing to guess about.
  # Not for a web notification, though: every one of those is `-i
  # google-chrome`, and the browser showing the page is the one thing the
  # icon must not be. The site wins there.
  if args.app_icon and not web:
    hit = from_icon_theme([args.app_icon])
    if hit:
      return hit, "from_icon_theme:hint"

  if web:
    index = load_index()
    host = web[0]  # Never guess or contact a parent domain.
    stored = index.get(host)
    note = dict(stored) if isinstance(stored, dict) else {}
    cached = note.get(args.scheme)
    if cached:
      safe = safe_cached_remote_icon(host, args.scheme, cached)
      if safe:
        # A validated public cache stays useful while fetching is off.
        return safe, "cache"
      invalidate_cached_remote_icon(host, args.scheme, cached)
      note.pop(args.scheme, None)
      note["failed_at"] = 0
      index[host] = note
      save_index(index)

    # This is the network boundary: every cache check above is local, and
    # no metadata, favicon, DNS, proxy, cookie jar, or credential lookup is
    # attempted unless the caller supplied --fetch.
    if args.fetch:
      failed_at = note.get("failed_at", 0)
      if type(failed_at) not in (int, float) or not math.isfinite(failed_at):
        failed_at = 0
      if failed_at <= time.time() - RETRY_AFTER:
        hit = fetch_site(host, args.scheme)
        note["failed_at"] = 0 if hit else time.time()
        if hit:
          note[args.scheme] = hit
        index[host] = note
        save_index(index)
        if hit:
          return hit, "fetched:" + host

  # Whatever delivered it, as a last resort before the letter tile.
  for step in (from_icon_theme, from_desktop_entries):
    hit = step(app)
    if hit:
      return hit, step.__name__ + ":app"
  return None, "none"


def main(argv=None):
  argv = list(sys.argv[1:] if argv is None else argv)
  ap = argparse.ArgumentParser()
  ap.add_argument("--key", default="")
  ap.add_argument("--app", default="")
  ap.add_argument("--app-icon", default="")
  ap.add_argument("--source", default="")
  ap.add_argument("--scheme", default="dark", choices=["dark", "light"])
  ap.add_argument("--fetch", action="store_true")
  ap.add_argument("--why", action="store_true", help="print where it came from")
  ap.add_argument("--sender-image", action="store_true")
  args = ap.parse_args(argv)
  if args.sender_image:
    if argv != ["--sender-image"]:
      return 2
    try:
      result = sender_image_data_url(sys.stdin.buffer)
    except Exception:
      return 1
    sys.stdout.write(result)
    return 0
  for field in ("key", "app", "app_icon", "source"):
    if len(getattr(args, field)) > 256: return 2
  private_dir(CACHE)
  path, how = resolve(args)
  if path:
    path = normalise(path)
  if path:
    sys.stdout.write(path + ("\t" + how if args.why else ""))
  elif args.why:
    sys.stdout.write("\t" + how)
  return 0


if __name__ == "__main__":
  sys.exit(main())
