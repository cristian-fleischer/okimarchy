<?xml version="1.0" encoding="UTF-8"?>
<!-- ImageMagick policy for the notification helpers (notification_images.py).
     Everything is denied except reading the raster formats the helpers sniff
     for, rasterising local SVG icons with librsvg, and the PAM pipe the
     helpers read pixels back through. No delegates, filters, @file reads or
     other coders, whatever a file asks for. -->
<policymap>
  <policy domain="delegate" rights="none" pattern="*"/>
  <policy domain="filter" rights="none" pattern="*"/>
  <policy domain="coder" rights="none" pattern="*"/>
  <policy domain="coder" rights="read" pattern="{PNG,JPEG,WEBP,ICO,RSVG}"/>
  <policy domain="coder" rights="read|write" pattern="{PAM,PNM}"/>
  <policy domain="path" rights="none" pattern="@*"/>
  <policy domain="module" rights="none" pattern="{MSL,MVG,TEXT,URL,HTTP,HTTPS,FTP,EPHEMERAL,LABEL,CAPTION,PS,PDF,EPS,XPS,SHOW,WIN,X,MSVG}"/>
</policymap>
