#!/usr/bin/python3
"""Run Omarchy's notification helpers sandboxed when possible, or directly by policy.

  run status                 print the sandbox status as JSON
  run store VERB [ARGS...]   the notification store (see store)
  run icon ARGS...           icon resolution (see icon); --sender-image reads a path on stdin
  run kdeconnect VERB ...    the KDE Connect reply bridge (see kdeconnect)

OMARCHY_NOTIFICATIONS_REQUIRE_SANDBOX=1 refuses to run a helper without an
operational Bubblewrap sandbox; unset or 0 runs it directly when there is none.
"""
import json
from functools import partial
import os
from pathlib import Path
import re
import resource
import signal
import stat
import subprocess
import sys
import time
from urllib.parse import unquote

# Launched by its shebang, without -B: keep the sibling import from writing
# __pycache__ into the Omarchy checkout the helpers live in.
sys.dont_write_bytecode = True
from notification_files import private_dir, write_bytes  # noqa: E402
import notification_images as images  # noqa: E402


# The helpers sit beside this file. Resolve through any symlinks (a dev
# checkout reached through a linked OMARCHY_PATH) so the sandbox mounts, and
# direct mode runs, the real files rather than a path that only exists outside.
BASE = Path(__file__).resolve().parent
HOME_DIR = Path.home()
STATE = HOME_DIR / ".local/state/omarchy/notifications"
# Icons the shell displays. Written only here, outside every sandbox, from
# pixels a helper decoded; no helper mount reaches it.
PUBLISHED = HOME_DIR / ".cache/omarchy/notification-icons"
PUBLISHED_KEEP = 512
ICON_OUTPUT_BYTES = images.PIXELS_HEADER_BYTES + 128 * 128 * 4
SENDER_DATA_URL_CHARS = 131072
BWRAP = Path("/usr/bin/bwrap")
PYTHON = Path("/usr/bin/python3")
HELPER_KINDS = frozenset(("store", "icon", "kdeconnect"))
TERMINATE_GRACE = 2
SENDER_PATH_BYTES = 4096
SENDER_IMAGE_BYTES = 1024 * 1024
SANDBOX_ROOT = "/opt/omarchy-notifications"
POLICY_VARIABLE = "OMARCHY_NOTIFICATIONS_REQUIRE_SANDBOX"
DEMO_APP = "Omarchy reply demo"


class WrapperInterrupted(Exception):
  def __init__(self, signum):
    super().__init__(signum)
    self.signum = signum


def require_policy(environ):
  value = environ.get(POLICY_VARIABLE)
  if value in (None, "0"):
    return False
  if value == "1":
    return True
  raise ValueError("invalid sandbox policy")


def executable(path):
  return path.is_file() and os.access(path, os.X_OK)


def bubblewrap_path():
  return str(BWRAP) if executable(BWRAP) else None


def clean_environment(extra=None):
  environ = {
      "HOME": str(HOME_DIR),
      "LANG": "C.UTF-8",
      "PATH": "/usr/bin",
      "PYTHONDONTWRITEBYTECODE": "1",
  }
  if extra:
    environ.update(extra)
  return environ


def validated_bus_environment(environ):
  address = environ.get("DBUS_SESSION_BUS_ADDRESS", "")
  if not address.startswith("unix:path=") or ";" in address:
    raise RuntimeError("unsupported session bus address")
  encoded_path, separator, option = address[len("unix:path="):].partition(",")
  if separator:
    if (not option.startswith("guid=") or len(option[5:]) != 32
            or any(c not in "0123456789abcdefABCDEF" for c in option[5:])):
      raise RuntimeError("unsupported session bus address")
  bus = Path(unquote(encoded_path, errors="strict"))
  runtime_text = environ.get("XDG_RUNTIME_DIR")
  runtime = Path(runtime_text) if runtime_text else bus.parent
  if (not bus.is_absolute() or not runtime.is_absolute() or bus.parent != runtime
          or "\x00" in str(bus) or "\x00" in str(runtime)):
    raise RuntimeError("session bus unavailable")
  try:
    runtime_stat = os.lstat(runtime)
    bus_stat = os.lstat(bus)
  except OSError as error:
    raise RuntimeError("session bus unavailable") from error
  if (not stat.S_ISDIR(runtime_stat.st_mode) or runtime_stat.st_uid != os.geteuid()
          or runtime_stat.st_mode & 0o077):
    raise RuntimeError("session bus unavailable")
  if not stat.S_ISSOCK(bus_stat.st_mode) or bus_stat.st_uid != os.geteuid():
    raise RuntimeError("session bus unavailable")
  return {
      "XDG_RUNTIME_DIR": str(runtime),
      "DBUS_SESSION_BUS_ADDRESS": address,
  }, bus


# Kernel interfaces, not files a sender could mean as a picture. They report
# themselves as regular files (/proc/<pid>/environ is one, size 0), so they are
# refused by where the opened file really is, wherever the path pointed, and by
# the type of filesystem it lives on, which a bind mount elsewhere cannot hide.
PSEUDO_FILESYSTEMS = ("/proc/", "/sys/", "/dev/")
PSEUDO_FILESYSTEM_TYPES = frozenset((
    "proc", "sysfs", "devtmpfs", "devpts", "debugfs", "tracefs", "securityfs", "cgroup", "cgroup2",
    "configfs", "pstore", "bpf", "efivarfs", "fusectl", "mqueue", "binfmt_misc", "hugetlbfs", "autofs"))
SENDER_READ_SECONDS = 5


def filesystem_type(device):
  wanted = "%d:%d" % (os.major(device), os.minor(device))
  try:
    with open("/proc/self/mountinfo", encoding="utf-8", errors="replace") as mounts:
      for line in mounts:
        fields = line.split()
        if len(fields) > 4 and fields[2] == wanted and " - " in line:
          return line.split(" - ", 1)[1].split()[0]
  except OSError:
    return None
  return ""


def opened_in_pseudo_filesystem(fd, info):
  try:
    real = os.readlink("/proc/self/fd/%d" % fd)
  except OSError:
    return True
  if not real.startswith("/") or real.startswith(PSEUDO_FILESYSTEMS):
    return True
  kind = filesystem_type(info.st_dev)
  return kind is None or kind in PSEUDO_FILESYSTEM_TYPES


def sender_path(stream):
  raw_path = stream.read(SENDER_PATH_BYTES + 1)
  if len(raw_path) > SENDER_PATH_BYTES:
    raise ValueError("sender image path too long")
  path = raw_path.decode("utf-8", "strict")
  if (not path or not os.path.isabs(path)
          or any(ord(character) < 32 or ord(character) == 127 for character in path)):
    raise ValueError("invalid sender image path")
  return path


def read_sender_file(path):
  """Open, check and read the sender's file. Runs in a disposable child."""
  fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC)
  try:
    info = os.fstat(fd)
    if (not stat.S_ISREG(info.st_mode) or not 0 < info.st_size <= SENDER_IMAGE_BYTES
            or opened_in_pseudo_filesystem(fd, info)):
      raise ValueError("invalid sender image source")
    os.set_blocking(fd, True)
    chunks, size = [], 0
    while size <= SENDER_IMAGE_BYTES:
      chunk = os.read(fd, min(65536, SENDER_IMAGE_BYTES + 1 - size))
      if not chunk:
        break
      chunks.append(chunk)
      size += len(chunk)
    if size > SENDER_IMAGE_BYTES:
      raise ValueError("sender image grew too large")
    return b"".join(chunks)
  finally:
    os.close(fd)


def open_sender_image(stream, timeout=SENDER_READ_SECONDS):
  """A sealed in-memory copy of the sender's file, for the helper's stdin.

  Every filesystem operation on a path the sender chose happens in a forked
  child under a deadline: on a stalled FUSE mount, lookup and open can block
  however the file is opened, and only killing the child gets the launcher -
  and the sender-image queue behind it - back. The launcher never touches the
  path itself."""
  path = sender_path(stream)
  launcher = os.getpid()
  read_end, write_end = os.pipe()
  pid = os.fork()
  if pid == 0:
    status = 1
    try:
      os.close(read_end)
      # Dies with the launcher, however the launcher ends.
      die_with_parent(launcher)
      # A reader stuck on a stalled mount must not hold the caller's pipes
      # open after the launcher has given up on it.
      null = os.open(os.devnull, os.O_RDWR)
      for standard in (0, 1, 2):
        os.dup2(null, standard)
      data = read_sender_file(path)
      view = memoryview(data)
      while view:
        view = view[os.write(write_end, view):]
      status = 0
    except BaseException:
      pass
    finally:
      os._exit(status)
  os.close(write_end)
  status = None
  try:
    reader = os.fdopen(read_end, "rb", buffering=0)
    with reader:
      deadline = time.monotonic() + timeout
      data = read_bounded(reader, SENDER_IMAGE_BYTES, deadline)
    while status is None and time.monotonic() < deadline:
      done, code = os.waitpid(pid, os.WNOHANG)
      if done:
        status = code
      else:
        time.sleep(0.01)
  finally:
    if status is None:
      reap_killed(pid)
  if status is None or os.waitstatus_to_exitcode(status) != 0:
    raise ValueError("sender image unavailable")
  import fcntl
  fd = os.memfd_create("sender-image", os.MFD_CLOEXEC | os.MFD_ALLOW_SEALING)
  try:
    view = memoryview(data)
    while view:
      view = view[os.write(fd, view):]
    # Sealed: nothing can change the copy once it is made.
    fcntl.fcntl(fd, fcntl.F_ADD_SEALS, fcntl.F_SEAL_WRITE | fcntl.F_SEAL_GROW
                | fcntl.F_SEAL_SHRINK | fcntl.F_SEAL_SEAL)
    os.lseek(fd, 0, os.SEEK_SET)
    return fd
  except BaseException:
    os.close(fd)
    raise


def die_with_parent(parent):
  import ctypes
  libc = ctypes.CDLL(None, use_errno=True)
  PR_SET_PDEATHSIG = 1
  if libc.prctl(PR_SET_PDEATHSIG, signal.SIGKILL, 0, 0, 0) != 0:
    raise OSError(ctypes.get_errno(), "prctl failed")
  # The launcher may already have gone before the request took effect.
  if os.getppid() != parent:
    os._exit(1)


def read_bounded(stream, limit, deadline):
  import selectors
  chunks, size = [], 0
  with selectors.DefaultSelector() as selector:
    selector.register(stream, selectors.EVENT_READ)
    while True:
      remaining = deadline - time.monotonic()
      if remaining <= 0:
        raise ValueError("sender image read timed out")
      if not selector.select(remaining):
        continue
      chunk = os.read(stream.fileno(), 65536)
      if not chunk:
        return b"".join(chunks)
      size += len(chunk)
      if size > limit:
        raise ValueError("sender image too large")
      chunks.append(chunk)


def reap_killed(pid):
  try:
    os.kill(pid, signal.SIGKILL)
  except ProcessLookupError:
    return
  # A FUSE wait ends on SIGKILL. Anything that still does not is left to be
  # reaped by init once the launcher exits, rather than waited on here.
  for _ in range(100):
    try:
      if os.waitpid(pid, os.WNOHANG)[0]:
        return
    except ChildProcessError:
      return
    time.sleep(0.01)


def python_helper(kind, args, root=SANDBOX_ROOT):
  if kind not in HELPER_KINDS:
    raise ValueError("unknown helper")
  # -E ignores PYTHONDONTWRITEBYTECODE, so -B keeps bytecode out of the helpers too.
  return [str(PYTHON), "-B", "-E", "-s", f"{root}/{kind}", *args]


def sandbox_command(kind, args, bwrap, environ):
  if kind not in (*HELPER_KINDS, "check"):
    raise ValueError("unknown helper")
  cmd = [bwrap, "--die-with-parent", "--new-session", "--unshare-all",
         "--cap-drop", "ALL", "--ro-bind", "/usr", "/usr", "--proc", "/proc",
         "--dev", "/dev", "--tmpfs", "/tmp", "--tmpfs", "/home",
         "--dir", str(HOME_DIR), "--clearenv", "--setenv", "HOME", str(HOME_DIR),
         "--setenv", "PATH", "/usr/bin", "--setenv", "LANG", "C.UTF-8",
         "--setenv", "PYTHONDONTWRITEBYTECODE", "1", "--chdir", "/tmp"]
  for name in ("lib", "lib64", "bin", "sbin"):
    if Path("/" + name).exists():
      cmd += ["--symlink", "usr/" + name, "/" + name]
  for name in ("/etc/ld.so.cache", "/etc/nsswitch.conf"):
    if Path(name).exists():
      cmd += ["--ro-bind", name, name]
  cmd += ["--ro-bind", str(BASE), SANDBOX_ROOT]
  if kind == "check":
    return cmd + ["/usr/bin/true"]

  sender_image = kind == "icon" and args == ["--sender-image"]
  if not sender_image:
    private_dir(STATE)
  if kind == "store":
    cmd += ["--bind", str(STATE), str(STATE)]
  elif kind == "icon" and not sender_image:
    icons = private_dir(STATE / "icons")
    cmd += ["--bind", str(icons), str(icons)]
    for part in (".local/share/icons", ".local/share/applications",
                 ".config/omarchy/notifications/icons"):
      path = HOME_DIR / part
      if path.is_dir() and not path.is_symlink():
        cmd += ["--ro-bind", str(path), str(path)]
    if "--fetch" in args:
      cmd += ["--share-net"]
      for name in ("/etc/resolv.conf", "/etc/ssl/certs", "/etc/ca-certificates"):
        if Path(name).exists():
          cmd += ["--ro-bind", name, name]
  elif kind == "kdeconnect":
    bus_environment, bus = validated_bus_environment(environ)
    cmd += ["--ro-bind", str(bus), str(bus)]
    for name, value in bus_environment.items():
      cmd += ["--setenv", name, value]

    # A reply demo gets only its private fixture/result directory. Normal
    # phone operations never receive the notification store mount.
    demo_request = (len(args) == 3 and args[:2] == ["find", DEMO_APP]) or (
        len(args) == 5 and args[0] == "reply"
        and re.fullmatch(r"demo:[0-9a-f]{32}", args[1]) is not None
        and args[3] == DEMO_APP)
    demo = STATE / "reply-demo"
    if demo_request and demo.is_dir() and not demo.is_symlink():
      private_dir(demo)
      cmd += ["--ro-bind" if args[0] == "find" else "--bind",
              str(demo), str(demo)]
  return cmd + python_helper(kind, args)


def direct_command(kind, args):
  return python_helper(kind, args, str(BASE))


def direct_environment(kind, environ):
  if kind not in HELPER_KINDS:
    raise ValueError("unknown helper")
  extra = validated_bus_environment(environ)[0] if kind == "kdeconnect" else None
  return clean_environment(extra)


def limits():
  resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
  resource.setrlimit(resource.RLIMIT_CPU, (30, 30))
  resource.setrlimit(resource.RLIMIT_AS, (512 * 1024 * 1024, 512 * 1024 * 1024))
  resource.setrlimit(resource.RLIMIT_FSIZE, (2 * 1024 * 1024, 2 * 1024 * 1024))


def prepare_child(signal_mask):
  signal.pthread_sigmask(signal.SIG_SETMASK, signal_mask)
  limits()


def stop_process_group(proc):
  if proc.returncode is not None:
    return
  try:
    os.killpg(proc.pid, signal.SIGTERM)
  except ProcessLookupError:
    try:
      proc.wait()
    except ChildProcessError:
      pass
    return

  # Observe the leader without reaping it. Keeping its PID reserved makes the
  # final group signal safe while descendants get a grace period to exit.
  deadline = time.monotonic() + TERMINATE_GRACE
  while time.monotonic() < deadline:
    try:
      exited = os.waitid(os.P_PID, proc.pid,
                         os.WEXITED | os.WNOHANG | os.WNOWAIT)
    except ChildProcessError:
      # Another waiter already reaped it; the numeric PGID is no longer
      # safely attributable to this launch.
      return
    if exited:
      break
    time.sleep(0.02)
  try:
    # Always finish the known group: the leader may have exited on TERM
    # while a descendant ignored it. The unreaped leader prevents PID reuse.
    os.killpg(proc.pid, signal.SIGKILL)
  except ProcessLookupError:
    pass
  try:
    proc.wait()
  except ChildProcessError:
    pass


def collect_output(proc, limit, deadline):
  """Read the child's stdout to EOF, at most `limit` bytes, before `deadline`."""
  import selectors
  chunks, size = [], 0
  with selectors.DefaultSelector() as selector:
    selector.register(proc.stdout, selectors.EVENT_READ)
    while True:
      remaining = deadline - time.monotonic()
      if remaining <= 0:
        raise subprocess.TimeoutExpired(proc.args, 0)
      if not selector.select(remaining):
        continue
      chunk = os.read(proc.stdout.fileno(), 65536)
      if not chunk:
        return b"".join(chunks)
      size += len(chunk)
      if size > limit:
        raise ValueError("helper output too large")
      chunks.append(chunk)


def run_supervised(argv, environ, timeout, stdin_descriptor=None, capture=None):
  handled_signals = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)
  previous = {}

  def interrupted(signum, _frame):
    raise WrapperInterrupted(signum)

  old_mask = signal.pthread_sigmask(signal.SIG_BLOCK, handled_signals)
  masked = True
  proc = None
  try:
    for signum in handled_signals:
      previous[signum] = signal.signal(signum, interrupted)
    # Output streams deliberately inherit unchanged. A supplied descriptor
    # becomes child stdin without exposing its source path to argv or logs.
    # The child is a session leader so termination and deadlines reap its group.
    child_setup = partial(prepare_child, old_mask)
    proc = subprocess.Popen(argv, env=environ, preexec_fn=child_setup,
                            stdin=stdin_descriptor, start_new_session=True,
                            stdout=subprocess.PIPE if capture else None)
    masked = False
    signal.pthread_sigmask(signal.SIG_SETMASK, old_mask)
    try:
      if not capture:
        return proc.wait(timeout=timeout)
      deadline = time.monotonic() + timeout
      output = collect_output(proc, capture, deadline)
      return proc.wait(timeout=max(0.1, deadline - time.monotonic())), output
    except BaseException:
      # Whatever went wrong, the helper does not outlive the launcher's answer.
      stop_process_group(proc)
      raise
    finally:
      if proc.stdout:
        proc.stdout.close()
  except WrapperInterrupted:
    if proc is not None:
      stop_process_group(proc)
    raise
  finally:
    try:
      if masked:
        signal.pthread_sigmask(signal.SIG_SETMASK, old_mask)
    finally:
      for signum, handler in previous.items():
        signal.signal(signum, handler)


def probe_sandbox(bwrap):
  try:
    return run_supervised(sandbox_command("check", [], bwrap, {}),
                          clean_environment(), 5) == 0
  except (OSError, subprocess.TimeoutExpired):
    return False


def mode_status(required):
  bwrap = bubblewrap_path()
  operational = bool(bwrap and probe_sandbox(bwrap))
  mode = "sandboxed" if operational else ("blocked" if required else "direct")
  return {
      "bubblewrapAvailable": bwrap is not None,
      "sandboxOperational": operational,
      "required": required,
      "unsandboxedFallback": not required,
      "mode": mode,
  }, bwrap


def run_helper(kind, args, required, environ, stdin_descriptor=None):
  if kind not in HELPER_KINDS:
    raise ValueError("unknown helper")
  sender_image = kind == "icon" and args == ["--sender-image"]
  if "--sender-image" in args and not sender_image:
    raise ValueError("invalid sender image invocation")
  if sender_image != (stdin_descriptor is not None):
    raise ValueError("invalid sender image input")
  status, bwrap = mode_status(required)
  if status["mode"] == "blocked":
    raise RuntimeError("sandbox required")
  # Icons are hostile input end to end - a website's favicon, a file a sender
  # points at - and decoding them is the riskiest thing these helpers do. That
  # never runs unsandboxed: without a working sandbox the card shows a letter.
  if kind == "icon" and status["mode"] != "sandboxed":
    raise RuntimeError("image decoding needs the sandbox")
  if status["mode"] == "sandboxed":
    argv = sandbox_command(kind, args, bwrap, environ)
    child_environment = clean_environment()
  else:
    argv = direct_command(kind, args)
    child_environment = direct_environment(kind, environ)
  # This is the sole actual-helper execution. A failure is returned directly;
  # it is never replayed in a less restricted mode.
  if kind != "icon":
    return run_supervised(argv, child_environment, 45, stdin_descriptor)
  # One icon job resolves one source; a slow or hostile site must not hold the
  # icon queue for long. Its output is pixels, bounded, which become a PNG here.
  code, output = run_supervised(argv, child_environment, 20, stdin_descriptor, ICON_OUTPUT_BYTES)
  if code != 0:
    return code
  sys.stdout.write(publish_icon(output, sender_image, "--why" in args))
  return 0


def publish_icon(output, sender_image, why):
  """The PNG for a helper's pixels: a data: URL for a sender image, else a
  file in PUBLISHED named by its own digest, so equal icons share one file and
  a different icon can never overwrite it."""
  import base64
  import hashlib
  width, height, rgba, mono, how = images.unpack_pixels(output, 128)
  if sender_image:
    if not width:
      raise ValueError("no sender image")
    url = "data:image/png;base64," + base64.b64encode(images.encode_png(width, height, rgba)).decode("ascii")
    if len(url) > SENDER_DATA_URL_CHARS:
      raise ValueError("sender image too large")
    return url
  suffix = "\t" + how if why else ""
  if not width:
    return suffix
  png = images.encode_png(width, height, rgba)
  folder = private_dir(PUBLISHED)
  path = folder / (hashlib.sha256(png).hexdigest() + ("-mono" if mono else "") + ".png")
  write_bytes(path, png)
  prune_published(folder)
  return str(path) + suffix


def prune_published(folder):
  try:
    entries = sorted((entry.stat(follow_symlinks=False).st_mtime, entry.path)
                     for entry in os.scandir(folder) if entry.name.endswith(".png"))
  except OSError:
    return
  for _, path in entries[:-PUBLISHED_KEEP]:
    try:
      os.unlink(path)
    except OSError:
      pass


def main(argv=None, environ=None):
  argv = list(sys.argv[1:] if argv is None else argv)
  environ = os.environ if environ is None else environ
  try:
    if not argv:
      raise ValueError("helper kind required")
    kind, args = argv[0], argv[1:]
    required = require_policy(environ)
    if kind == "status":
      if args:
        raise ValueError("status takes no arguments")
      print(json.dumps(mode_status(required)[0]))
      return 0
    if kind == "icon" and args == ["--sender-image"]:
      sender_fd = open_sender_image(sys.stdin.buffer)
      try:
        return run_helper(kind, args, required, environ, sender_fd)
      finally:
        os.close(sender_fd)
    return run_helper(kind, args, required, environ)
  except WrapperInterrupted as error:
    return 128 + error.signum
  except (OSError, UnicodeError, ValueError, RuntimeError, subprocess.TimeoutExpired):
    sys.stderr.write("omarchy notifications: helper unavailable; sandbox policy or input rejected\n")
    return 1


if __name__ == "__main__":
  sys.exit(main())
