# The default run: enough sources to group, enough singles to stack.
DEFAULT = ["chat", "work", "personal", "system"]


def slug(text):
  out = ""
  for ch in str(text or "").lower():
    out += ch if ch.isalnum() else "-"
  return "-".join(part for part in out.split("-") if part)


def identity(n):
  """What the shell will make of this one: the key it groups under and the
  fields the icon resolver needs. Kept here so the demo can warm the icon
  cache before it starts - a demo whose first card of every source is a
  letter tile is showing the loading state, not the product."""
  if n.get("web"):
    return dict(key="web:" + n["web"], source=n["web"],
                app="Google Chrome", icon="google-chrome")
  app = n.get("app") or "omarchy-dev-notification-demo"
  return dict(key="app:" + slug(app), source=app, app=app, icon=n.get("icon") or "")


def scheme():
  """dark or light, as the shell will ask for it."""
  try:
    mode = subprocess.run(["omarchy-theme-color", "mode", "dark"], capture_output=True,
                          text=True, check=False, timeout=5).stdout.strip()
  except (OSError, subprocess.TimeoutExpired):
    mode = ""
  return "light" if mode == "light" else "dark"


def bounded_output(command, limit=65536, timeout=5, env=None):
  with subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=env) as proc:
    data = bytearray()
    deadline = time.monotonic() + timeout
    try:
      with selectors.DefaultSelector() as selector:
        selector.register(proc.stdout, selectors.EVENT_READ)
        while True:
          remaining = deadline - time.monotonic()
          if remaining <= 0 or not selector.select(remaining):
            raise TimeoutError("demo helper deadline")
          block = os.read(proc.stdout.fileno(), min(4096, limit + 1 - len(data)))
          if not block:
            break
          data.extend(block)
          if len(data) > limit:
            raise ValueError("demo helper output limit")
      if proc.wait(timeout=max(.01, deadline - time.monotonic())) != 0:
        raise ValueError("demo helper failed")
      return data.decode("utf-8")
    finally:
      if proc.poll() is None:
        proc.terminate()
        try:
          proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
          proc.kill()
          proc.wait()


def helper_policy():
  # The shell owns the settings. Ask it rather than parsing them here; an
  # unavailable or pending policy must not bypass a required sandbox.
  fetch, required = False, True
  try:
    probe = json.loads(bounded_output(["omarchy-shell", "notifications", "probe"]))
    security = probe.get("security", {})
    if (security.get("mode") in ("sandboxed", "direct", "blocked")
        and isinstance(security.get("required"), bool)
        and isinstance(probe.get("fetchRemoteIcons"), bool)):
      fetch, required = probe["fetchRemoteIcons"], security["required"]
  except (OSError, ValueError, AttributeError, TimeoutError, subprocess.TimeoutExpired):
    pass
  return fetch, dict(os.environ, OMARCHY_NOTIFICATIONS_REQUIRE_SANDBOX="1" if required else "0")


def warm(items):
  """Resolve every icon these notifications will want, before sending any.

  Resolution is a subprocess and sometimes a network fetch, so the first
  notification from a source arrives before its icon does. That is honest
  behaviour and invisible in normal use; in a demo it is the first thing you
  see."""
  seen, wanted = set(), []
  for n in items:
    who = identity(n)
    if who["key"] in seen:
      continue
    seen.add(who["key"])
    wanted.append(who)
  if not wanted:
    return
  print("warming %d icons..." % len(wanted), file=sys.stderr)
  fetch, environment = helper_policy()
  theme = scheme()
  for who in wanted:
    command = [HELPER, "icon", "--key", who["key"], "--source", who["source"],
               "--app", who["app"], "--app-icon", who["icon"], "--scheme", theme]
    if fetch:
      command.append("--fetch")
    try:
      bounded_output(command, timeout=55, env=environment)
    except (OSError, ValueError, TimeoutError, subprocess.TimeoutExpired):
      pass


class Bus:
  """Sends notifications the way any app does, and hears what became of them.

  Cards that ask to report their action print the action key when it is
  invoked, so a dismissal that opened the card instead shows up here."""

  def __init__(self):
    self.connection = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    self.reporting = set()
    self.connection.signal_subscribe(BUS_NAME, BUS_NAME, None, BUS_PATH, None,
                                     Gio.DBusSignalFlags.NONE, self.signal)

  def signal(self, _connection, _sender, _path, _interface, name, parameters):
    if name == "ActionInvoked":
      notification, action = parameters.unpack()
      if notification in self.reporting:
        print(action, flush=True)
        self.reporting.discard(notification)
    elif name == "NotificationClosed":
      self.reporting.discard(parameters.unpack()[0])

  def send(self, n, timeout=None):
    who = identity(n)
    body = n.get("body", "")
    if n.get("web"):
      body = web(n["web"], body)
    actions = []
    for action in n.get("actions", []):
      key, _, label = action.partition("=")
      actions += [key, label or key]
    hints = {}
    if who["icon"]:
      hints["desktop-entry"] = GLib.Variant("s", who["icon"])
    if n.get("urgency"):
      hints["urgency"] = GLib.Variant("y", URGENCY[n["urgency"]])
    parameters = GLib.Variant("(susssasa{sv}i)", (
      who["app"], 0, who["icon"], n.get("summary", ""), body, actions, hints,
      -1 if timeout is None else timeout))
    reply = self.connection.call_sync(BUS_NAME, BUS_PATH, BUS_NAME, "Notify", parameters,
                                      GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE,
                                      5000, None)
    if n.get("report_action"):
      self.reporting.add(reply.unpack()[0])

  def pump(self, seconds):
    """Wait, while still hearing the shell's signals."""
    loop = GLib.MainLoop()
    GLib.timeout_add(max(1, int(seconds * 1000)), lambda: loop.quit() or False)
    loop.run()

  def settle(self):
    """Keep the reporting cards answerable until each has been dealt with."""
    while self.reporting:
      self.pump(0.2)


def replay(limit, match):
  """Send notifications from history again, as they arrived.

  Invented examples only exercise the shapes someone thought of. Replaying
  what a machine actually received is how you find out that KDE Connect puts
  the originating app in the summary, or that a site you have never
  configured has no icon."""
  try:
    _, environment = helper_policy()
    raw = bounded_output([HELPER, "store", "history", str(limit)], limit=2 * 1024 * 1024,
                         timeout=55, env=environment)
    rows = json.loads(raw or "[]")
  except (OSError, ValueError, TimeoutError, subprocess.TimeoutExpired):
    rows = []
  needle = (match or "").lower()
  out = []
  for r in reversed(rows):  # oldest first, as they happened
    if not isinstance(r, dict):
      continue
    if needle:
      blob = " ".join(str(r.get(k) or "") for k in ("app", "source", "summary", "body")).lower()
      if needle not in blob:
        continue
    out.append(dict(app=r.get("app") or "omarchy-dev-notification-demo",
                    icon=r.get("appIcon") or "",
                    summary=r.get("summary") or "",
                    # The raw body where there is one: the stored body has had
                    # the source anchor lifted off, and replaying that makes
                    # every Chrome notification look like it came from Chrome
                    # rather than from the site.
                    body=r.get("rawBody") or r.get("body") or ""))
  return out


def open_web_hosts():
  """Sites that already have a window on this desktop.

  Omarchy's web apps carry their host in the Hyprland class -
  "chrome-web.whatsapp.com__-Default" - which is how the shell decides that a
  notification from web.whatsapp.com belongs to that window."""
  try:
    raw = subprocess.run(["hyprctl", "-j", "clients"], capture_output=True, text=True,
                         check=False, timeout=5).stdout
    clients = json.loads(raw or "[]")
  except (OSError, ValueError, subprocess.TimeoutExpired):
    return []
  hosts = []
  for c in clients:
    wm = str(c.get("class") or "")
    if not wm.startswith("chrome-"):
      continue
    host = wm[len("chrome-"):].split("__")[0]
    if "." in host and host not in hosts:
      hosts.append(host)
  return hosts


# Candidates for the "nothing open" case, in preference order. Whichever is not
# currently on screen gets used.
CLOSED_CANDIDATES = ("linear.app", "notion.com", "app.slack.com", "github.com",
                     "figma.com", "example.com")


def routing_scene():
  """One notification per way a click can be routed.

  Built from what is actually open, because the interesting case - a site
  that already has a window - cannot be written down in advance."""
  live = open_web_hosts()
  items = []
  for host in live[:2]:
    items.append(dict(web=host, summary=host.split(".")[0].title(),
                      body="click me: the window showing %s should come forward" % host,
                      expect="focus the existing %s window" % host))
  closed = next((h for h in CLOSED_CANDIDATES if h not in live), "example.com")
  items.append(dict(web=closed, summary=closed.split(".")[0].title(),
                    body="click me: nothing is showing %s, so it should open" % closed,
                    expect="open https://%s/ (no window for it)" % closed))
  items.append(dict(app="kitty", icon="kitty", summary="Tests passed",
                    body="click me: a local app, so its own default action runs",
                    expect="the sender's own default action"))
  return items


# The KDE Connect helper only answers this app name from the stand-in phone,
# and the sandbox launcher mounts only this directory for it.
DEMO_APP = "Omarchy reply demo"
DEMO_STATE = os.path.expanduser("~/.local/state/omarchy/notifications/reply-demo")
DEMO_FIXTURE = os.path.join(DEMO_STATE, "notification.json")
DEMO_REPLY = os.path.join(DEMO_STATE, "reply.json")


def reply_scene():
  """Create an explicit, short-lived demo session with no real phone target."""
  who, message = "Seif Lotfy", "did you get the build working in the end?"
  write_json(DEMO_FIXTURE, dict(token=secrets.token_hex(16), created=time.time(),
                                title=who, text=message))
  return [dict(app="KDE Connect", icon="whatsapp", summary=DEMO_APP,
               body="%s: %s" % (who, message))]


def clear():
  # dismissAll takes every card off screen; `clear` would forget history instead.
  subprocess.run(["omarchy-shell", "-q", "notifications", "dismissAll"], check=False)


def run(bus, scenes, gap, timeout, shuffle):
  for name in scenes:
    items = list(SCENES[name])
    if shuffle:
      random.shuffle(items)
    for n in items:
      bus.send(n, timeout)
      # A notification can ask to be followed quickly: a burst from one
      # source is how a stack forms, and at the scene's normal pace the first
      # card has half faded before the second lands.
      bus.pump(min(gap, n["gap"]) if "gap" in n else gap)
  bus.settle()


def main():
  ap = argparse.ArgumentParser(prog="omarchy-dev-notification-demo")
  ap.add_argument("--scene", action="append", choices=sorted(SCENES),
                  help="just this one (repeatable); default is %s" % ", ".join(DEFAULT))
  ap.add_argument("--fast", action="store_true", help="tighter pacing, for recording")
  ap.add_argument("--gap", type=float, help="seconds between notifications")
  ap.add_argument("--timeout", type=int, help="how long each stays up, ms")
  ap.add_argument("--loop", action="store_true", help="keep going until interrupted")
  ap.add_argument("--shuffle", action="store_true")
  ap.add_argument("--keep", action="store_true", help="do not clear first")
  ap.add_argument("--list", action="store_true", help="list the scenes")
  ap.add_argument("--replay", type=int, metavar="N",
                  help="re-send the last N notifications from history")
  ap.add_argument("--match", help="only replay ones mentioning this")
  args = ap.parse_args()

  if args.list:
    for name, items in sorted(SCENES.items()):
      print("%-11s %s" % (name, "built when run" if not items else "%d notifications" % len(items)))
    return 0

  # Slow enough to actually read a card before the next one lands on it;
  # --fast keeps the tight pacing that recordings want.
  gap = args.gap if args.gap is not None else (0.9 if args.fast else 3.2)
  scenes = args.scene or DEFAULT

  if "close" in scenes:
    print("hover Close on the front card, then click it three times, waiting for each "
          "move to finish without moving the pointer.", file=sys.stderr)
    print("each card should dismiss; any 'default' printed here means a card was "
          "opened instead.", file=sys.stderr)

  if "reply" in scenes:
    SCENES["reply"] = reply_scene()
    print("hover the card, press Reply, type something and hit Enter.", file=sys.stderr)
    print("the latest reply is saved to %s - not sent to anyone." % DEMO_REPLY, file=sys.stderr)

  if "routing" in scenes:
    SCENES["routing"] = routing_scene()
    print("what each one should do when you click it:", file=sys.stderr)
    for n in SCENES["routing"]:
      print("   %-22s %s" % (n["summary"], n["expect"]), file=sys.stderr)

  bus = Bus()

  if args.replay:
    items = replay(args.replay, args.match)
    if not items:
      print("nothing in the notification history matches", file=sys.stderr)
      return 1
  else:
    items = [n for name in scenes for n in SCENES[name]]
    warm(items)

  if not args.keep:
    clear()
    time.sleep(0.4)

  try:
    if args.replay:
      print("replaying %d" % len(items))
      for n in items:
        bus.send(n, args.timeout)
        bus.pump(gap)
      return 0
    run(bus, scenes, gap, args.timeout, args.shuffle)
    while args.loop:
      bus.pump(gap * 2)
      run(bus, scenes, gap, args.timeout, args.shuffle)
  except KeyboardInterrupt:
    pass
  return 0


if __name__ == "__main__":
  sys.exit(main())
