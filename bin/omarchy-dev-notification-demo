#!/usr/bin/python3
# omarchy:summary=Play a realistic run of notifications to look at the notification UI
# omarchy:args=[--scene <name>]... [--fast] [--gap <seconds>] [--timeout <ms>] [--loop] [--shuffle] [--keep] [--list] [--replay <count> [--match <text>]]
# omarchy:examples=omarchy dev notification demo --list | omarchy dev notification demo --scene interactive | omarchy dev notification demo --scene reply | omarchy dev notification demo --replay 10 --match slack
# omarchy:hidden=true
"""A realistic run of notifications, for looking at the notification UI.

  --list                what scenes there are
  --scene chat          only one part of it (repeatable); default is chat, work, personal, system
  --scene interactive   codes, links and the sender's buttons
  --scene routing       where a click sends you, per source
  --scene reply         inline reply, against a stand-in phone
  --scene close         repeated dismissals without moving the pointer
  --fast                same scene, tighter, for a recording
  --loop                keep going until interrupted
  --replay N            send the last N notifications from history again

The senders here are the ones that actually notify this desktop - Chrome
announcing a web app through a leading anchor, KDE Connect naming a device in
the summary, a terminal, a backup job - because those shapes are what the
grouping and the markup parsing have to cope with. The words are invented;
nothing here is anybody's real message.

Notifications go straight onto the session bus, exactly as a sending app's
would; the shell is driven through `omarchy-shell notifications <method>`.
"""
import argparse
import json
import os
import random
import secrets
import selectors
import subprocess
import sys
import time

from gi.repository import Gio, GLib

HELPERS = os.path.join(os.environ["OMARCHY_PATH"], "shell/plugins/notifications/helpers")
HELPER = os.path.join(HELPERS, "run")
sys.dont_write_bytecode = True
sys.path.insert(0, HELPERS)
from notification_files import write_json  # noqa: E402

BUS_NAME = "org.freedesktop.Notifications"
BUS_PATH = "/org/freedesktop/Notifications"
URGENCY = {"low": 0, "normal": 1, "critical": 2}


# Chrome puts a link to the origin on the front of every web notification, and
# that anchor is what tells app.slack.com apart from mail.google.com.
def web(host, body):
  return '<a href="https://%s/">%s</a>\n\n%s' % (host, host, body)


SCENES = {
  # People. Chrome announces a web app through a leading anchor, and that
  # anchor is the only thing that tells app.slack.com from web.whatsapp.com -
  # both of them are "Google Chrome" as far as the bus is concerned.
  "chat": [
